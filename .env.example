# LLM API configuration (supports any LLM API compatible with the OpenAI SDK format)
# Recommended: Alibaba Qwen-plus model via Bailian platform: https://bailian.console.aliyun.com/
# Note: token usage can be high — try a simulation with fewer than 40 rounds first
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== Zep Memory Graph Configuration =====
# The free monthly quota is sufficient for basic usage: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Boost LLM Configuration (optional) =====
# Note: if you are not using the boost configuration, omit these keys from the env file entirely
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here